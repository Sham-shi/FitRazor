@page
@model FitRazor.Web.Pages.Dashboard.ClientModel
@{
    ViewData["Title"] = "Личный кабинет";
}

<div class="container mt-4">
    @* 🔹 Шапка профиля *@
    <div class="card card-dark shadow-sm mb-4">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-8 text-light">
                    <h2 class="mb-1">👋 Здравствуйте, @Model.ClientProfile?.FullName!</h2>
                    <p class="mb-0">
                        <i class="bi bi-telephone me-1"></i> @Model.ClientProfile?.Phone<br />
                        <i class="bi bi-envelope me-1"></i> @Model.UserProfile?.Email
                    </p>
                </div>
                <div class="col-md-4 text-md-end">
                    <a asp-page="/Entities/Edit" asp-route-entityName="Clients" asp-route-id="@Model.ClientProfile?.ClientId"
                       class="btn btn-primary">
                        <i class="bi bi-pencil-square me-1"></i> Редактировать профиль
                    </a>
                </div>
            </div>
        </div>
    </div>

    @* 🔹 Секция с бронированиями *@
    <div class="card card-dark shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="mb-0 text-light">📅 Мои записи</h4>
            <a asp-page="/Entities/Create" asp-route-entityName="Bookings" class="btn btn-success btn-sm">
                <i class="bi bi-plus-lg me-1"></i> Новая запись
            </a>
        </div>
        <div class="card-body">
            @if (!Model.Bookings.Any())
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>У вас пока нет активных записей.
                    <a asp-page="/Entities/Create" asp-route-entityName="Bookings">Создать первую запись</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Дата и время</th>
                                <th>Тренер</th>
                                <th>Услуга</th>
                                <th>Кол-во занятий</th>
                                <th>Стоимость</th>
                                <th>Статус</th>
                                <th class="text-center">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var booking in Model.Bookings)
                            {
                                <tr>
                                    <td>@booking.BookingDateTime.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>@booking.TrainerService?.Trainer?.FullName ?? "—"</td>
                                    <td>@booking.TrainerService?.Service?.ServiceName ?? "—"</td>
                                    <td>@booking.SessionsCount</td>
                                    <td class="text-success fw-bold">@booking.TotalPrice?.ToString("N2") ₽</td>
                                    <td>
                                        @{
                                            var badgeClass = booking.Status switch
                                            {
                                                                "Запланировано" => "bg-primary",
                                                                "Перенесено" => "bg-warning text-dark",
                                                                "Завершено" => "bg-success",
                                                                "Отменено" => "bg-danger",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @badgeClass">@booking.Status</span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-page="/Entities/Details" asp-route-entityName="Bookings" asp-route-id="@booking.BookingId"
                                               class="btn btn-info" title="Детали">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            @if (booking.Status == "Запланировано" || booking.Status == "Перенесено")
                                            {
                                                <a asp-page="/Entities/Edit" asp-route-entityName="Bookings" asp-route-id="@booking.BookingId"
                                                   class="btn btn-primary" title="Редактировать">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <button type="button" class="btn btn-danger"
                                                        data-bs-toggle="modal" data-bs-target="#deleteModal"
                                                        data-entity-name="Bookings"
                                                        data-entity-id="@booking.BookingId"
                                                        data-entity-display="@booking.TrainerService?.Service?.ServiceName на @booking.BookingDateTime.ToString("dd.MM.yyyy")"
                                                        title="Удалить">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@* 🔹 Модальное окно удаления *@
<div class="modal fade modal-dark" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title">⚠️ Подтверждение удаления</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Вы уверены, что хотите удалить запись?</p>
                <p class="small text-muted"><strong id="deleteEntityDisplay">...</strong></p>
                <div class="alert alert-warning mb-0">
                    <i class="bi bi-exclamation-triangle-fill"></i> Это действие нельзя отменить!
                </div>
            </div>
            <div class="modal-footer">
                <form id="deleteConfirmForm" method="post" asp-page="/Entities/Index" asp-page-handler="Delete">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="entityName" id="hiddenEntityName" />
                    <input type="hidden" name="id" id="hiddenEntityId" />
                    <button type="submit" class="btn btn-danger">🗑️ Да, удалить</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">❌ Отмена</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const modal = document.getElementById('deleteModal');
            if (!modal) return;

            modal.addEventListener('show.bs.modal', event => {
                const btn = event.relatedTarget;
                document.getElementById('deleteEntityDisplay').textContent = btn.dataset.entityDisplay;
                document.getElementById('hiddenEntityName').value = btn.dataset.entityName;
                document.getElementById('hiddenEntityId').value = btn.dataset.entityId;

                const form = document.getElementById('deleteConfirmForm');
                form.action = `/Entities/Index?handler=Delete&entityName=${btn.dataset.entityName}&id=${btn.dataset.entityId}`;
            });
        });
    </script>
}