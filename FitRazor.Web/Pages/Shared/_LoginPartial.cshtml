@* Pages/Shared/_LoginPartial.cshtml *@
@using FitRazor.Data.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    // 🔹 Получаем текущего пользователя для отображения имени
    var currentUser = await UserManager.GetUserAsync(User);
    var displayName = currentUser?.UserName ?? User.Identity?.Name;
}

@if (SignInManager.IsSignedIn(User))
{
    <!-- 🔹 Авторизованный пользователь -->
    <span class="text-muted small d-none d-md-inline me-2">
        <i class="bi bi-person-circle me-1"></i>@displayName
    </span>

    <form asp-page="/Account/Logout" method="post" class="d-inline">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-danger btn-sm text-uppercase">
            <i class="bi bi-box-arrow-right me-1"></i>Выйти
        </button>
    </form>
}
else
{
    <!-- 🔹 Гость -->
    <a asp-page="/Account/Login"
       asp-route-returnUrl="@Context.Request.Path"
       class="btn btn-outline-primary-glow btn-sm text-uppercase">
        <i class="bi bi-box-arrow-in-right me-1"></i>Войти
    </a>
}

@if (User.IsInRole("Admin"))
{
    <!-- Кнопка админ-панели (offcanvas) -->
    <button class="btn btn-link text-muted p-0 gp-btn-admin"
            type="button"
            data-bs-toggle="offcanvas"
            data-bs-target="#adminMenu"
            aria-controls="adminMenu"
            aria-label="Панель администратора">
        <i class="bi bi-gear-fill"></i>
    </button>
}
else if(User.IsInRole("Trainer"))
{
    <!-- 🔹 Тренер -->
    <a asp-page="/Dashboard/Trainer"
       class="btn btn-outline-primary-glow btn-sm text-uppercase">
        <i class="bi bi-person-gear me-1"></i>Профиль
    </a>
}
else if (User.IsInRole("Client"))
{
    <!-- 🔹 Клиент -->
    <a asp-page="/Dashboard/Client"
       class="btn btn-outline-primary-glow btn-sm text-uppercase">
        <i class="bi bi-person-gear me-1"></i>Профиль
    </a>
}
